# Copy this file to .env and fill in the values, then run:
#   docker compose up --build

# Contents of config/master.key (generated by `rails new`, or run
# `bin/rails credentials:edit` to create one if you don't have it yet).
RAILS_MASTER_KEY=

# Credentials for the first login. A user is only ever created if none
# exists yet, so these are only used on the very first boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Host port to publish the app on (defaults to 3000).
# PORT=3000
