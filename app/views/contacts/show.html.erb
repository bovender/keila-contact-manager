<% content_for :title, @contact.email %>

<% registered_keys = @custom_field_definitions.map(&:key) %>
<% extra_keys = @contact.data.keys - registered_keys - [ Contact::RESERVED_DATA_KEY ] %>

<div class="w-full max-w-2xl">
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="font-bold text-3xl text-gray-900"><%= @contact.full_name.presence || @contact.email %></h1>
      <p class="text-gray-500"><%= @contact.email %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_contact_path(@contact), class: "rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
      <%= button_to "Delete", contact_path(@contact), method: :delete,
            form: { data: { turbo_confirm: "Delete #{@contact.email}?" } },
            class: "rounded-md px-3.5 py-2 border border-red-300 text-red-600 hover:bg-red-50 font-medium cursor-pointer" %>
    </div>
  </div>

  <dl class="divide-y divide-gray-100 border border-gray-200 rounded-lg mb-8">
    <div class="px-4 py-3 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Status</dt>
      <dd class="col-span-2 text-sm text-gray-900"><%= @contact.status.presence || "—" %></dd>
    </div>
    <div class="px-4 py-3 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">External ID</dt>
      <dd class="col-span-2 text-sm text-gray-900"><%= @contact.external_id.presence || "—" %></dd>
    </div>
    <div class="px-4 py-3 grid grid-cols-3 gap-4">
      <dt class="text-sm font-medium text-gray-500">Tags</dt>
      <dd class="col-span-2 text-sm text-gray-900">
        <% if @contact.tags.any? %>
          <% @contact.tags.each do |t| %>
            <%= link_to t, contacts_path(tag: t), class: "inline-block px-2 py-0.5 mr-1 mb-1 rounded-full text-xs bg-gray-100 text-gray-700 hover:bg-gray-200" %>
          <% end %>
        <% else %>
          —
        <% end %>
      </dd>
    </div>
    <% @custom_field_definitions.reject(&:protected?).each do |cfd| %>
      <div class="px-4 py-3 grid grid-cols-3 gap-4">
        <dt class="text-sm font-medium text-gray-500"><%= cfd.label %></dt>
        <dd class="col-span-2 text-sm text-gray-900"><%= @contact.custom_field(cfd.key).presence || "—" %></dd>
      </div>
    <% end %>
  </dl>

  <% if extra_keys.any? %>
    <div class="border border-amber-200 bg-amber-50 rounded-lg p-4">
      <h2 class="text-sm font-semibold text-amber-800 mb-2">Unregistered fields</h2>
      <p class="text-xs text-amber-700 mb-3">
        This contact has data for these keys, but they're not in the
        <%= link_to "custom fields registry", custom_field_definitions_path, class: "underline" %>,
        so they don't show up as a normal field above or in the contacts
        table. Register a key to give it a proper label, or remove it (and
        its data) permanently from the registry page once registered.
      </p>
      <dl class="divide-y divide-amber-100">
        <% extra_keys.each do |key| %>
          <div class="py-2 grid grid-cols-3 gap-4">
            <dt class="text-sm font-mono text-amber-800"><%= key %></dt>
            <dd class="col-span-2 text-sm text-amber-900"><%= @contact.custom_field(key) %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  <% end %>

  <%= link_to "← Back to contacts", contacts_path, class: "inline-block mt-6 text-gray-500 hover:text-gray-700" %>
</div>
