<% content_for :title, "Sync from Keila" %>

<div class="w-full max-w-xl">
  <%= render "shared/flash" %>
  <h1 class="font-bold text-3xl text-gray-900 mb-4">Sync from Keila</h1>

  <p class="text-gray-600 mb-4">
    This pulls every contact from the Keila instance configured in
    <%= link_to "Settings", edit_settings_path, class: "underline" %> and
    upserts them here, matching by this app's own id, then Keila's
    External ID, then email. Tags are never touched &mdash; Keila's API
    doesn't expose them.
  </p>

  <div class="border border-gray-200 rounded-lg divide-y divide-gray-100 mb-6 text-sm">
    <div class="px-4 py-3 grid grid-cols-2 gap-4">
      <span class="text-gray-500">Keila instance</span>
      <span class="text-gray-900 font-mono"><%= Setting.instance.keila_url %></span>
    </div>
    <div class="px-4 py-3 grid grid-cols-2 gap-4">
      <span class="text-gray-500">Contacts reported by Keila</span>
      <span class="text-gray-900 font-semibold"><%= @keila_count %></span>
    </div>
    <div class="px-4 py-3 grid grid-cols-2 gap-4">
      <span class="text-gray-500">Contacts here right now</span>
      <span class="text-gray-900 font-semibold"><%= @local_count %></span>
    </div>
  </div>

  <p class="text-xs text-gray-500 mb-6">
    Double-check the instance URL above matches where you meant to point
    this app &mdash; a stale or wrong API key would otherwise merge in
    contacts from a completely different Keila project without warning.
  </p>

  <%= button_to "Yes, pull #{@keila_count} contact(s) from Keila", sync_from_keila_contacts_path,
        class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <%= link_to "Cancel", contacts_path, class: "ml-2 rounded-md px-3.5 py-2.5 border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium" %>
</div>
