<%= form_with model: contact, class: "space-y-6" do |form| %>
  <% if contact.errors.any? %>
    <div class="py-2 px-3 bg-red-50 text-red-600 rounded-lg text-sm">
      <ul class="list-disc list-inside">
        <% contact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.email_field :email, required: true, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>
    <div>
      <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :status, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>
    <div>
      <%= form.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :first_name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>
    <div>
      <%= form.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :last_name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>
    <div>
      <%= form.label :external_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :external_id, class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>
    <div>
      <%= form.label :tag_list, "Tags", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :tag_list, value: contact.tag_list, placeholder: "vip, newsletter", class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>
  </div>

  <div>
    <h2 class="text-lg font-semibold text-gray-900 mb-2">Custom fields</h2>
    <p class="text-sm text-gray-500 mb-3">
      Need a field that isn't listed here? Add it once on the
      <%= link_to "custom fields page", custom_field_definitions_path, class: "underline" %> and it will show up for every contact.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% custom_field_definitions.each do |cfd| %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1"><%= cfd.label %></label>
          <%= text_field_tag "contact[custom_fields][#{cfd.key}]", contact.custom_field(cfd.key),
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex gap-2">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancel", contacts_path, class: "rounded-md px-3.5 py-2.5 border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium" %>
  </div>
<% end %>
