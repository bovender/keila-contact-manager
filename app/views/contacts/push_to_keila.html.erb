<% content_for :title, "Push to Keila" %>

<div class="w-full max-w-xl">
  <%= render "shared/flash" %>
  <h1 class="font-bold text-3xl text-gray-900 mb-4">Push to Keila</h1>

  <p class="text-gray-600 mb-4">
    This pushes every contact here to the Keila instance configured in
    <%= link_to "the active project", edit_keila_project_path(current_project), class: "underline" %>,
    creating or updating as needed (matched by email, then External ID).
    Tags are sent along as part of each contact's custom data.
  </p>

  <div class="border border-gray-200 rounded-lg divide-y divide-gray-100 mb-6 text-sm">
    <div class="px-4 py-3 grid grid-cols-2 gap-4">
      <span class="text-gray-500">Keila instance</span>
      <span class="text-gray-900 font-mono"><%= current_project.keila_url %></span>
    </div>
    <div class="px-4 py-3 grid grid-cols-2 gap-4">
      <span class="text-gray-500">Contacts here that will be pushed</span>
      <span class="text-gray-900 font-semibold"><%= @local_count %></span>
    </div>
    <div class="px-4 py-3 grid grid-cols-2 gap-4">
      <span class="text-gray-500">Contacts Keila already has</span>
      <span class="text-gray-900 font-semibold"><%= @keila_count %></span>
    </div>
  </div>

  <p class="text-xs text-gray-500 mb-6">
    Double-check the instance URL above matches where you meant to point
    this app &mdash; a stale or wrong API key would otherwise push these
    contacts into a completely different Keila project without warning.
  </p>

  <div class="flex gap-2">
    <%= button_to "Yes, push #{@local_count} contact(s) to Keila", push_to_keila_contacts_path,
          class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancel", contacts_path, class: "rounded-md px-3.5 py-2.5 border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium" %>
  </div>
</div>
