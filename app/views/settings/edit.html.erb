<% content_for :title, "Settings" %>

<div class="w-full max-w-2xl">
  <%= render "shared/flash" %>
  <h1 class="font-bold text-3xl text-gray-900 mb-2">Settings</h1>

  <p class="text-gray-600 mb-6">
    Connect this app to your self-hosted Keila instance's API key (create
    one in Keila under a project's Settings &rarr; API). The app works fine
    with CSV import/export alone if you leave this blank.
  </p>

  <%= form_with model: @setting, url: settings_path, method: :patch, class: "space-y-4 max-w-lg" do |form| %>
    <% if @setting.errors.any? %>
      <div class="py-2 px-3 bg-red-50 text-red-600 rounded-lg text-sm">
        <ul class="list-disc list-inside">
          <% @setting.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :keila_url, "Keila instance URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.url_field :keila_url, placeholder: "https://keila.example.com", class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    </div>

    <div>
      <%= form.label :keila_api_key, "Keila API key", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.password_field :keila_api_key, value: nil,
            placeholder: @setting.keila_api_key.present? ? "•••••••• (unchanged)" : "",
            autocomplete: "off",
            class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
      <p class="text-xs text-gray-500 mt-1">Stored encrypted. Leave blank to keep the current key.</p>
    </div>

    <%= form.submit "Save settings", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <% end %>

  <% if @setting.configured_for_sync? %>
    <%= button_to "Test connection", test_connection_settings_path, method: :post,
          class: "mt-4 rounded-md px-3.5 py-2 border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium cursor-pointer" %>
  <% end %>
</div>
