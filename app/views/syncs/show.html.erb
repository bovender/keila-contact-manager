<% content_for :title, "Sync with Keila" %>

<% from_keila = @plan.from_keila %>
<% from_here = @plan.from_here %>
<% conflicted = @plan.conflicted %>

<div class="w-full max-w-4xl">
  <h1 class="font-bold text-3xl text-gray-900 mb-2">Sync with Keila</h1>
  <p class="text-gray-600 mb-6">
    Project <span class="font-semibold"><%= current_project.name %></span> at
    <span class="font-mono text-sm"><%= KeilaProject.keila_url %></span>.
    <% if current_project.synced? %>
      Last synced <%= time_ago_in_words(current_project.last_synced_at) %> ago.
    <% else %>
      This is the first sync: contacts that exist on both sides are paired up by
      email (or External ID); where both sides have a different value for the same
      field, you decide below.
    <% end %>
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8 text-sm">
    <div class="border border-gray-200 rounded-lg px-4 py-3">
      <div class="text-gray-500">From Keila</div>
      <div class="text-2xl font-semibold text-gray-900"><%= from_keila.size %></div>
    </div>
    <div class="border border-gray-200 rounded-lg px-4 py-3">
      <div class="text-gray-500">From here to Keila</div>
      <div class="text-2xl font-semibold text-gray-900"><%= from_here.size %></div>
    </div>
    <div class="border rounded-lg px-4 py-3 <%= @plan.conflict_count.positive? ? 'border-amber-300 bg-amber-50' : 'border-gray-200' %>">
      <div class="text-gray-500">Conflicts to decide</div>
      <div class="text-2xl font-semibold text-gray-900"><%= @plan.conflict_count %></div>
    </div>
  </div>

  <%= form_with url: sync_path, method: :post, data: { turbo_confirm: (@plan.deletions? ? "This sync deletes contacts (see the lists). Continue?" : nil) } do %>
    <% if conflicted.any? %>
      <h2 class="text-lg font-semibold text-gray-900 mb-1">Conflicts</h2>
      <p class="text-sm text-gray-500 mb-3">Changed on both sides since the last sync. Pick the version to keep.</p>
      <div class="border border-amber-200 rounded-lg divide-y divide-amber-100 mb-8">
        <% conflicted.each do |item| %>
          <div class="p-4 space-y-3">
            <div class="font-medium text-gray-900"><%= item.email %></div>
            <% item.conflicts.each do |token, field| %>
              <% if field %>
                <% f = item.fields[field] %>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-sm items-start">
                  <span class="text-gray-500"><%= sync_field_label(field) %></span>
                  <label class="flex items-start gap-2 cursor-pointer">
                    <%= radio_button_tag "resolutions[#{token}]", "local", false, required: true %>
                    <span><span class="text-xs text-gray-400 block">Here</span><%= sync_value(f[:local]) %></span>
                  </label>
                  <label class="flex items-start gap-2 cursor-pointer">
                    <%= radio_button_tag "resolutions[#{token}]", "remote", false, required: true %>
                    <span><span class="text-xs text-gray-400 block">Keila</span><%= sync_value(f[:remote]) %></span>
                  </label>
                </div>
              <% else %>
                <% deleted_in_keila = item.kind == :remote_deleted_conflict %>
                <p class="text-sm text-gray-600">
                  <%= deleted_in_keila ? "Deleted in Keila, but changed here since the last sync." : "Deleted here, but changed in Keila since the last sync." %>
                </p>
                <div class="flex flex-wrap gap-6 text-sm">
                  <label class="flex items-center gap-2 cursor-pointer">
                    <%= radio_button_tag "resolutions[#{token}]", "local", false, required: true %>
                    <%= deleted_in_keila ? "Keep it (re-create in Keila)" : "Delete it in Keila too" %>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <%= radio_button_tag "resolutions[#{token}]", "remote", false, required: true %>
                    <%= deleted_in_keila ? "Delete it here too" : "Keep it (restore here)" %>
                  </label>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% [ [ "From Keila", from_keila, :pull_fields ], [ "From here to Keila", from_here, :push_fields ] ].each do |heading, items, fields_method| %>
      <% next if items.empty? %>
      <details class="mb-6" <%= "open" if items.size <= 20 %>>
        <summary class="text-lg font-semibold text-gray-900 cursor-pointer mb-2"><%= heading %> (<%= items.size %>)</summary>
        <ul class="border border-gray-200 rounded-lg divide-y divide-gray-100 text-sm">
          <% items.each do |item| %>
            <li class="px-4 py-2 flex flex-wrap gap-x-3">
              <span class="font-medium text-gray-900"><%= item.email %></span>
              <span class="text-gray-600">
                <%= sync_item_description(item, item.public_send(fields_method)) %>
              </span>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>

    <% if @plan.in_sync? %>
      <p class="mb-6 text-green-700">Everything is in sync.</p>
    <% end %>

    <div class="flex gap-2">
      <%= submit_tag (@plan.in_sync? ? "Sync anyway" : "Sync now"),
            class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <%= link_to "Cancel", contacts_path, class: "rounded-md px-3.5 py-2.5 border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium" %>
    </div>
  <% end %>
</div>
