<%= form_with model: keila_project, url: url, class: "space-y-4 max-w-lg" do |form| %>
  <% if keila_project.errors.any? %>
    <div class="py-2 px-3 bg-red-50 text-red-600 rounded-lg text-sm">
      <ul class="list-disc list-inside">
        <% keila_project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, placeholder: "Newsletter", class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
  </div>

  <div>
    <%= form.label :keila_url, "Keila instance URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.url_field :keila_url, placeholder: "https://keila.example.com", class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
  </div>

  <div>
    <%= form.label :keila_api_key, "Keila API key", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.password_field :keila_api_key, value: nil,
          placeholder: keila_project.keila_api_key.present? ? "•••••••• (unchanged)" : "",
          autocomplete: "off",
          class: "block w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-blue-600" %>
    <p class="text-xs text-gray-500 mt-1">
      Create one in Keila under this project's Settings &rarr; API. Stored
      encrypted. Leave blank to keep the current key. A project works fine
      with CSV import/export alone if you leave this blank entirely.
    </p>
  </div>

  <div class="flex gap-2">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancel", keila_projects_path, class: "rounded-md px-3.5 py-2.5 border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium" %>
  </div>
<% end %>
