<% content_for :title, "Custom fields" %>

<div class="w-full max-w-2xl">
  <%= render "shared/flash" %>
  <h1 class="font-bold text-3xl text-gray-900 mb-2">Custom fields</h1>
  <p class="text-gray-600 mb-6">
    These are the custom data fields known to the app. New fields are added
    automatically when you import a CSV with unfamiliar columns, or you can
    add one by hand below. Removing a field here only removes it from forms
    and the contacts table &mdash; existing contact data is kept.
  </p>

  <div class="border border-gray-200 rounded-lg divide-y divide-gray-100 mb-8">
    <% @custom_field_definitions.each do |cfd| %>
      <% contacts_count = cfd.contacts_count %>
      <div class="p-3 space-y-2">
        <div class="flex items-center gap-3">
          <%= form_with model: cfd, class: "flex-1 flex items-center gap-3" do |form| %>
            <span class="text-xs text-gray-400 font-mono w-32 truncate" title="<%= cfd.key %>"><%= cfd.key %></span>
            <%= form.text_field :label, class: "flex-1 rounded-md border border-gray-300 px-2 py-1" %>
            <%= form.submit "Save", class: "rounded-md px-3 py-1.5 border border-gray-300 hover:bg-gray-50 cursor-pointer" %>
          <% end %>
          <span class="text-xs text-gray-500 whitespace-nowrap">
            used by <%= contacts_count %> contact<%= "s" unless contacts_count == 1 %>
          </span>
        </div>
        <div class="flex items-center gap-2">
          <%= button_to "Remove from registry", custom_field_definition_path(cfd), method: :delete,
                form: { data: { turbo_confirm: "Remove '#{cfd.label}' from the registry? Existing contact data is kept." } },
                class: "rounded-md px-3 py-1.5 border border-gray-300 text-gray-700 hover:bg-gray-50 cursor-pointer text-sm" %>
          <% if contacts_count > 0 %>
            <%= button_to "Remove & delete data", custom_field_definition_path(cfd, purge_data: true), method: :delete,
                  form: { data: { turbo_confirm: "This permanently deletes the '#{cfd.label}' value from #{contacts_count} contact#{'s' unless contacts_count == 1}. This cannot be undone. Continue?" } },
                  class: "rounded-md px-3 py-1.5 border border-red-300 text-red-600 hover:bg-red-50 cursor-pointer text-sm" %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @custom_field_definitions.empty? %>
      <p class="p-3 text-gray-500 text-sm">No custom fields yet.</p>
    <% end %>
  </div>

  <h2 class="text-lg font-semibold text-gray-900 mb-2">Add a custom field</h2>
  <%= form_with model: CustomFieldDefinition.new, url: custom_field_definitions_path, class: "flex items-end gap-3" do |form| %>
    <div>
      <%= form.label :key, "Key", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :key, placeholder: "Company", class: "rounded-md border border-gray-300 px-2 py-1" %>
    </div>
    <div>
      <%= form.label :label, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :label, placeholder: "Company", class: "rounded-md border border-gray-300 px-2 py-1" %>
    </div>
    <%= form.submit "Add field", class: "rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <% end %>
</div>
